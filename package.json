{
  "name": "cool-evidence-backend",
  "version": "1.0.0",
  "description": "Backend and CooL SDK integration for AI decision evidence recording and verification",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "build:all": "npm run build && npm run frontend:build",
    "start": "node dist/server.js",
    "test": "tsx tests/api.test.ts",
    "test:cool": "tsx scripts/test-cool.ts",
    "demo": "tsx scripts/e2e-demo.ts"
  },
  "keywords": [
    "cool",
    "evidence",
    "ai-provenance",
    "transparency-log",
    "refund-agent"
  ],
  "author": "CooL Evidence Team",
  "license": "Apache-2.0",
  "dependencies": {
    "cool-nwc": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.1.5"
  }
}
